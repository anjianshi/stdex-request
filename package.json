{
  "name": "@stdex/request",
  "version": "1.0.1",
  "description": "可靠、简洁的网络请求模块",
  "homepage": "https://github.com/anjianshi/stdex-request",
  "bugs": {
    "url": "https://github.com/anjianshi/stdex-request/issues",
    "email": "anjianshi@gmail.com"
  },
  "license": "MIT",
  "author": "anjianshi <anjianshi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anjianshi/stdex-request.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clear && tsc",
    "watch": "npm run clear && tsc --watch",
    "clear": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit && eslint './src/'"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist/"
  ],
  "dependencies": {
    "@stdex/logging": "^1.1.0",
    "@stdex/utils": "^1.0.2",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@stdex/presets-eslint-typescript": "^1.0.2",
    "@stdex/presets-prettier": "^1.0.2",
    "@stdex/presets-typescript": "^1.0.2",
    "@types/lodash": "^4.17.27",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3"
  },
  "prettier": "@stdex/presets-prettier/prettierrc"
}
